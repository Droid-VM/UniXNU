+/* Lazily allocated memory only (has_lazy_bos; no sparse resources): the memory's GPU address at once, its BO made there by the first
+ * pass that needs it (darwin_bo_init's lazy_vma), as the msm backend's set-IOVA path does. DroidVM: a memoryless texture -- a
+ * transient attachment, which Metal keeps in tile memory -- took memory of its own, wired guest pages, though a pass that renders in
+ * GMEM never touches it: the render server's memoryless targets held 45 MiB, the wallpaper's 4x MSAA ones 32. */
 static VkResult
 darwin_sparse_vma_init(struct tu_device *dev, struct vk_object_base *base,
                        struct tu_sparse_vma *out_vma, uint64_t *out_iova,
                        enum tu_sparse_vma_flags flags, uint64_t size, uint64_t client_iova)
 {
-   return vk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
+   if (flags & TU_SPARSE_VMA_MAP_ZERO)
+      return vk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
+   const enum tu_bo_alloc_flags bo_flags =
+      (flags & TU_SPARSE_VMA_REPLAYABLE) ? TU_BO_ALLOC_REPLAYABLE : TU_BO_ALLOC_NO_FLAGS;
+   out_vma->flags = flags;
+   out_vma->msm.size = size;
+   out_vma->msm.backs_lazy_bo = false;
+   VkResult result = darwin_allocate_iova(dev, size, client_iova, bo_flags, &out_vma->msm.iova);
+   if (result == VK_SUCCESS)
+      *out_iova = out_vma->msm.iova;
+   return result;
 }
 
 static void
 darwin_sparse_vma_finish(struct tu_device *dev, struct tu_sparse_vma *vma)
 {
+   if (!vma->msm.backs_lazy_bo)
+      darwin_free_iova(dev, vma->msm.iova, vma->msm.size);
 }
 
