 }
+
+static VkResult darwin_device_check_status(struct tu_device *device);
 
 static VkResult
 darwin_queue_submit(struct tu_queue *queue, void *_submit,
@@ -1614,6 +1616,16 @@
 
    if (submit->bad && darwin_check_mode() >= 2)
       return vk_device_set_lost(&dev->vk, "TU_DARWIN_CHECK_IBS: %u addresses of the submission have no live BO", submit->bad);
+
+   /* virtio GPU: a submission the host refused, or a GPU reset KGSL blamed on this context, shows only in the shmem's counters
+    * (GetStatus reads them there, no call): KGSL skips a reset context's later work and still retires its timestamps, so every
+    * fence after it completes at once with nothing drawn -- an Adreno 840 ran GFXBench Aztec at 1300 fps, "OK", after one CP
+    * fault. The device is lost at the next submission instead of only at a vkWaitForFences. */
+   if (dw.virtgpu) {
+      VkResult status = darwin_device_check_status(dev);
+      if (status != VK_SUCCESS)
+         return status;
+   }
 
    /* Every client submits to the kernel's one ring, which runs jobs in order, and each job's prologue flushes and invalidates the GPU
     * caches and waits for idle (NativeAdrenoRing::emitPrologue) before its buffers run. A wait on a sync already resolved to a ring
