       dwv.va_size = vg_get_param(DWV_MSM_PARAM_VA_SIZE, &kr);
+   /* Asking for the fault count is what has drm2kgsl count this context's GPU resets in the shmem's global_faults (GetStatus);
+    * a host without that answers 0 and counts only refused submissions (async_error). */
