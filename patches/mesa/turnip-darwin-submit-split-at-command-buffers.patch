+static bool
+darwin_entry_sets_thread(const struct tu_cs_entry *entry)
+{
+   if (!entry->bo->map || entry->size < 2 * sizeof(uint32_t))
+      return false;
+   const uint32_t *words = (const uint32_t *)((const char *)entry->bo->map + entry->offset);
+   return words[0] == pm4_pkt7_hdr(CP_THREAD_CONTROL, 1);
 }
 
