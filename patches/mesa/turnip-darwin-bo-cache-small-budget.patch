+/* BOs of at most 1 MiB are kept in a budget of their own (TU_DARWIN_BO_CACHE_SMALL_MB, 16 by default; 0: one budget for every BO,
+ * as before), the others in darwin_cache_budget's. On the DroidVM board a new BO is a round trip through the host's one virtio-gpu
+ * worker -- 10-35 ms for an 8 KiB one while a transition runs, about as long as for 64 MiB -- and in the render server the pooled
+ * 64 MiB blocks it frees took most of the shared budget, so the small BOs of command streams and descriptors went almost as soon
+ * as they were cached: 35 % of 20480 allocations reused, 11090 evictions, the misses' new BOs stalling Settings' opening, the app
+ * switcher and Spotlight 100-270 ms each. */
+static uint64_t
+darwin_cache_small_budget(void)
+{
+   static uint64_t budget = UINT64_MAX;
+   if (budget == UINT64_MAX) {
+      const char *text = getenv("TU_DARWIN_BO_CACHE_SMALL_MB");
+      budget = (text && *text ? strtoull(text, NULL, 10) : 16) << 20;
+   }
+   return budget;
+}
+
+static bool
+darwin_small(uint64_t size)
+{
+   return size <= ((uint64_t)1 << 20) && darwin_cache_small_budget();
+}
