 }
 
+/* The submitqueue priorities the host offers (its capset; one when it names none). */
+uint32_t
+dwv_priorities(void)
+{
+   return dwv.caps.priorities ? dwv.caps.priorities : 1;
+}
+
+/* Moves the process's submit queue to PRIORITY (msm: 0 highest) when that is higher than the queue's and nothing has been
+ * submitted yet: a new queue at that priority, on its ring (priority + 1), replaces the old one. Once something was submitted the
+ * fences are that ring's sequence, and the queue stays. */
+kern_return_t
+dwv_set_priority(uint32_t priority)
+{
+   kern_return_t kr = KERN_SUCCESS;
+   pthread_mutex_lock(&dwv.lock);
+   if (dwv.shmem && priority < dwv.priority && !dwv.submit_fence) {
+      struct { uint32_t flags, prio, id; } queue = {0, priority, 0};
+      kr = vg_ioctl_simple(DWV_MSM_SUBMITQUEUE_NEW, &queue, sizeof(queue));
+      if (kr == KERN_SUCCESS) {
+         uint32_t old = dwv.queue_id;
+         vg_ioctl_simple(DWV_MSM_SUBMITQUEUE_CLOSE, &old, sizeof(old));
+         dwv.queue_id = queue.id;
+         dwv.priority = priority;
+         dwv.ring = priority + 1;
+      }
+   }
+   pthread_mutex_unlock(&dwv.lock);
+   return kr;
+}
+
