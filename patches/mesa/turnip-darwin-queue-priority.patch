-   struct { uint32_t flags, prio, id; } queue = {0, 0, 0};
+   /* One submit queue, at the lowest of the host's priorities (msm: 0 highest), its default: the host's ring priority + 1. Every
+    * submission rides it, so its fences are one increasing sequence, as the NativeAdreno ABI's are. A Vulkan queue asking for a
