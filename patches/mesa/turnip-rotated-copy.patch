+/* DroidVM (private): chained to a VkCopyImageToBufferInfo2 or a VkCopyBufferToImageInfo2, it turns the copy on the 2D
+ * engine (RB_A2D_BLT_CNTL's ROTATE): the buffer holds the image region turned by `rotation` (an a6xx_rotation:
+ * ROTATE_90, ROTATE_180 or ROTATE_270), an image of the region's extent with its width and height swapped for a quarter
+ * turn, bufferRowLength texels a row. metal2vulkan turns Metal's rotated framebuffer (CoreAnimation's) with it, where it
+ * ran a compute kernel between two staging buffers. Only a one-layer copy through the 2D engine whose buffer address and
+ * pitch are 64-byte aligned is turned; any other is copied unturned, and logged.
+ */
+#define TU_STRUCTURE_TYPE_COPY_ROTATION_DROIDVM ((VkStructureType) 1000999001)
+struct tu_copy_rotation_droidvm {
+   VkStructureType sType;
+   const void *pNext;
+   uint32_t rotation;
+};
+
+static uint32_t
+tu_copy_rotation(const void *pNext)
+{
+   for (const VkBaseInStructure *s = (const VkBaseInStructure *) pNext; s; s = s->pNext) {
+      if (s->sType == TU_STRUCTURE_TYPE_COPY_ROTATION_DROIDVM)
+         return ((const struct tu_copy_rotation_droidvm *) s)->rotation;
+   }
+   return ROTATE_0;
+}
