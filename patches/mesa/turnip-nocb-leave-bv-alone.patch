diff --git a/src/freedreno/vulkan/tu_cs.h b/src/freedreno/vulkan/tu_cs.h
--- a/src/freedreno/vulkan/tu_cs.h
+++ b/src/freedreno/vulkan/tu_cs.h
@@ -94,6 +94,9 @@
    struct tu_device *device;
    enum tu_cs_mode mode;
    bool writeable;
+   /* Concurrent binning is off for the instance (a7xx+): nothing in this stream is for the binning thread, and every
+    * thread control carries CONCURRENT_BIN_DISABLE. See tu7_thread_control(). */
+   bool no_bv;
    uint32_t next_bo_size;
    VkResult status;
 
@@ -570,8 +573,20 @@
 static inline void
 tu7_thread_control(struct tu_cs *cs, enum cp_thread thread)
 {
+   /* The kernel's ringbuffer commands around a submission never set CONCURRENT_BIN_DISABLE, and a thread control whose
+    * flag differs from the last one's makes BR and BV synchronize: a request and an acknowledgement between the two
+    * microcodes, each draining its own pipeline first, and BV, when it is inside an IB, waiting for BR where it cannot
+    * be preempted. With concurrent binning off Turnip set the flag for a binning pass on BR and dropped it again after
+    * it (thread BV for the BV count, thread BOTH for the VPC attribute buffer...), so every pass synchronized twice and
+    * BV had work of its own. On an Adreno 840 under KGSL's hardware scheduling, with other ringbuffers preempting the
+    * context every frame, BV sometimes never drained (HLSQ busy on the BV pipe for good) or went on in a BR section as
+    * if it were its own: "GPU hang detected", about one start of a guest's compositor in fifteen. With the flag on
+    * every thread control its value changes once, at the first packet of a submission; BR executes what any thread is
+    * named for (it skips nothing while the flag is set) and BV executes nothing, as before concurrent binning.
+    */
    tu_cs_emit_pkt7(cs, CP_THREAD_CONTROL, 1);
-   tu_cs_emit(cs, CP_THREAD_CONTROL_0_THREAD(thread));
+   tu_cs_emit(cs, CP_THREAD_CONTROL_0_THREAD(thread) |
+                  (cs->no_bv ? (uint32_t) CP_THREAD_CONTROL_0_CONCURRENT_BIN_DISABLE : 0));
 }
 
