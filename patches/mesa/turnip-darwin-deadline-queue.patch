@@ -317,8 +317,11 @@
    /* The kernel client has queue 0 from open(); every submission rides the one shared ring. Through the virtio GPU that ring is
     * at the host's default priority, and a queue made with a higher global priority raises it for the process. */
    queue->msm_queue_id = 0;
-   if (dwv_enabled())
+   if (dwv_enabled()) {
       dwv_set_priority(queue->priority);
+      if (queue->global_priority >= VK_QUEUE_GLOBAL_PRIORITY_HIGH_KHR)
+         dwv_set_deadline();
+   }
    return 0;
 }
 
diff --git a/src/freedreno/vulkan/tu_knl_darwin_virtgpu.h b/src/freedreno/vulkan/tu_knl_darwin_virtgpu.h
