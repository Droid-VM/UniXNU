diff --git a/src/freedreno/vulkan/tu_knl_darwin_virtgpu.cc b/src/freedreno/vulkan/tu_knl_darwin_virtgpu.cc
--- a/src/freedreno/vulkan/tu_knl_darwin_virtgpu.cc
+++ b/src/freedreno/vulkan/tu_knl_darwin_virtgpu.cc
@@ -76,7 +76,7 @@
    pthread_mutex_t lock;     /* the ccmd sequence (one response area) and the handle table */
    volatile uint8_t *shmem;
    uint32_t shmem_handle, seqno;
-   uint32_t queue_id, ring, submit_fence, priority;
+   uint32_t queue_id, ring, submit_fence, priority, queue_flags;
    uint64_t next_blob_id;
    struct dwv_bo *bos;
    uint32_t bo_capacity;
@@ -264,6 +264,7 @@
    if (kr == KERN_SUCCESS) {
       dwv.queue_id = queue.id;
       dwv.priority = queue.prio;
+      dwv.queue_flags = queue.flags;
       dwv.ring = queue.prio + 1;
       dwv.submit_fence = 0;
       dwv.next_blob_id = 1;
@@ -292,7 +293,7 @@
    kern_return_t kr = KERN_SUCCESS;
    pthread_mutex_lock(&dwv.lock);
    if (dwv.shmem && priority < dwv.priority && !dwv.submit_fence) {
-      struct { uint32_t flags, prio, id; } queue = {0, priority, 0};
+      struct { uint32_t flags, prio, id; } queue = {dwv.queue_flags, priority, 0};
       kr = vg_ioctl_simple(DWV_MSM_SUBMITQUEUE_NEW, &queue, sizeof(queue));
       if (kr == KERN_SUCCESS) {
          uint32_t old = dwv.queue_id;
@@ -300,6 +301,33 @@
          dwv.queue_id = queue.id;
          dwv.priority = priority;
          dwv.ring = priority + 1;
+      }
+   }
+   pthread_mutex_unlock(&dwv.lock);
+   return kr;
+}
+
+/* A submit queue flag of the host's drm2kgsl, beyond msm's: the queue's submissions have a deadline (a compositor's frames), and
+ * the host runs the GPU at full clock while they run rather than at what its governor makes of the GPU's load -- the governor
+ * kept a 2048x2732 compositor's frames at 160 MHz a third of the time, 4.5 ms a pass where 1200 MHz takes 1.5. A host that knows
+ * no such flag ignores it. */
+#define DWV_SUBMITQUEUE_DEADLINE 0x80000000u
+
+/* Asks the host to treat the process's submit queue as having a deadline (DWV_SUBMITQUEUE_DEADLINE): a new queue with the flag, at
+ * the same priority, replaces the old one while nothing has been submitted on it; once something was, the queue stays as it is. */
+kern_return_t
+dwv_set_deadline(void)
+{
+   kern_return_t kr = KERN_SUCCESS;
+   pthread_mutex_lock(&dwv.lock);
+   if (dwv.shmem && !(dwv.queue_flags & DWV_SUBMITQUEUE_DEADLINE) && !dwv.submit_fence) {
+      struct { uint32_t flags, prio, id; } queue = {dwv.queue_flags | DWV_SUBMITQUEUE_DEADLINE, dwv.priority, 0};
+      kr = vg_ioctl_simple(DWV_MSM_SUBMITQUEUE_NEW, &queue, sizeof(queue));
+      if (kr == KERN_SUCCESS) {
+         uint32_t old = dwv.queue_id;
+         vg_ioctl_simple(DWV_MSM_SUBMITQUEUE_CLOSE, &old, sizeof(old));
+         dwv.queue_id = queue.id;
+         dwv.queue_flags = queue.flags;
       }
    }
    pthread_mutex_unlock(&dwv.lock);
