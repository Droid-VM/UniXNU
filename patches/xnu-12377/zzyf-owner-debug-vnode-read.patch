+// Board bring-up (debug VM only): owner-debug lets an owner debug binary read the guest to debug it -- open
+// (read only), read, readdir, lookup, stat, getattr and readlink of a file or directory a sandbox storage class or
+// data vault would otherwise deny even to root (the ssh shell could not read the logs daemons keep in their
+// containers). The relaxation is read only, is cleared only for a caller carrying the owner debug entitlement, and
+// only when the board asks for it; the boot argument, not the default, decides. No write path is touched.
+extern boolean_t IOCurrentTaskHasEntitlement(const char *);
+static int
+droidvm_owner_debug_vnode_read(void)
+{
+	uint32_t owner_debug = 0;
+	if (!PE_parse_boot_argn("owner-debug", &owner_debug, sizeof(owner_debug)) || owner_debug == 0) {
+		return 0;
+	}
+	return IOCurrentTaskHasEntitlement("com.apple.private.droidvm.debug") ? 1 : 0;
+}
+
