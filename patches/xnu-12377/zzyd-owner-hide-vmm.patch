diff --git a/bsd/kern/hvg_sysctl.c b/bsd/kern/hvg_sysctl.c
index fb0b67c..b3fe387 100644
--- a/bsd/kern/hvg_sysctl.c
+++ b/bsd/kern/hvg_sysctl.c
@@ -29,6 +29,8 @@
 #include <sys/sysctl.h>
 #include <libkern/libkern.h>
 #include <kern/hvg_hypercall.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc_internal.h>
 #include <stdbool.h>
 
 /* Translate hypercall error code to syscall error code */
@@ -141,6 +143,27 @@ sysctl_vmm_present(__unused struct sysctl_oid *oidp,
 #if defined(__arm64__)
 	extern int IODTGetDefault(const char *key, void *infoAddr, unsigned int infoSize );
 	(void) IODTGetDefault("vmm-present", &vmm_present, sizeof(vmm_present));
+	/* Board bring-up: owner-hide-vmm=NAME[,NAME...] hides the hypervisor from those processes. iPadOS 27's MobileGestalt
+	 * answers IsVirtualDevice from this sysctl, and in a virtual device its audio server (audiomxd: VirtualAudio) expects
+	 * Apple's research VM and serves only the Null device; backboardd and SpringBoard need it, or the backlight state
+	 * machine waits on panel hardware and its watchdog kills SpringBoard. The kernel's own readers still see /defaults
+	 * vmm-present: AMFI asks this sysctl from the kernel task and panics ("No PMGR?") on a device that is not virtual. */
+	char hide_vmm[128];
+	if (vmm_present && req->p != kernproc && PE_parse_boot_arg_str("owner-hide-vmm", hide_vmm, sizeof(hide_vmm))) {
+		const char *name = proc_best_name(req->p);
+		size_t length = strlen(name);
+		for (const char *entry = hide_vmm; *entry != '\0';) {
+			size_t entry_length = 0;
+			while (entry[entry_length] != '\0' && entry[entry_length] != ',') {
+				entry_length++;
+			}
+			if (entry_length == length && strncmp(entry, name, length) == 0) {
+				vmm_present = 0;
+				break;
+			}
+			entry += entry_length + (entry[entry_length] == ',');
+		}
+	}
 #elif defined(__x86_64__)
 	extern boolean_t cpuid_vmm_present(void);
 	vmm_present = cpuid_vmm_present();
