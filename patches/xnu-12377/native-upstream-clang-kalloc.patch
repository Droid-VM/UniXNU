+		 * Upstream LLVM emits no type summary, so every view of this kernel is data only (and takes the data
+		 * heap above), while the views of Apple's kexts carry their real type signatures: one heap policy for
+		 * both, every kext view is data only too. The entry points read the flag from the view itself.
+		 */
+		if (!kalloc_type_is_data(kt_flags)) {
+			if (type == KTV_FIXED) {
+				((kalloc_type_view_t)cur)->kt_flags |= KT_DATA_ONLY;
+			} else {
+				((kalloc_type_var_view_t)cur)->kt_flags |= KT_DATA_ONLY;
+			}
+		}
+		if (true) {
+#else
 		if (kalloc_type_is_data(kt_flags)) {
+#endif
 			kalloc_type_func(type, handle_data_view, cur);
 			cur += kalloc_type_func(type, view_sz);
 			continue;
@@ -1868,6 +1884,12 @@ kalloc_type_view_init_fixed(void)
 	 * all kalloc type views in kt_buffer.
 	 */
 	kt_count = kalloc_type_view_parse(KTV_FIXED);
+#if !__has_builtin(__builtin_xnu_type_summary)
+	if (kt_count == 0) {
+		/* Upstream LLVM: no type summary, every view is data only and took the data heap, nothing to place. */
+		return;
+	}
+#endif
 	assert(kt_count < KALLOC_TYPE_SIZE_MASK);
 
 #if MACH_ASSERT
@@ -1989,6 +2011,11 @@ kalloc_type_view_init_var(void)
 	 */
 	kt_count = kalloc_type_view_parse(KTV_VAR);
 	assert(kt_count < UINT32_MAX);
+#if !__has_builtin(__builtin_xnu_type_summary)
+	if (kt_count == 0) {
+		return; /* as kalloc_type_view_init_fixed */
+	}
+#endif
 
 #if MACH_ASSERT
 	vm_size_t sig_slist_size = (size_t) kt_count * sizeof(uint32_t);
