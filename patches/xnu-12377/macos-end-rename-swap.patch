+/**
+ *  @brief Notify that a swap rename has finished
+ *  @param cred User credential for the renaming process
+ *  @param v1 vnode 1 of the swap
+ *  @param vl1 label of vnode 1
+ *  @param v2 vnode 2 of the swap
+ *  @param vl2 label of vnode 2
+ *
+ *  The Darwin 26 hook that closes mpo_vnode_notify_will_rename_swap (begin_rename_swap there), called once the
+ *  rename returns, whether it succeeded or not. macOS 27's Sandbox holds the labels of both vnodes from the
+ *  begin hook to this one.
+ */
+typedef void mpo_vnode_notify_end_rename_swap_t(
+	kauth_cred_t cred,
+	struct vnode *v1,
+	struct label *vl1,
+	struct vnode *v2,
+	struct label *vl2
+	);
+
 /**
