k27 diagnostics: panic-spin=1 spins after a panic instead of restarting the VM
(Bring-up diagnostics of macOS-DroidVM, off unless their boot argument is given; opt-in: diag.series of
profiles/os/macos-27.0.1-26A434.)
From macOS-DroidVM patches/xnu-12377/0026 (lateautumn233).

diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index 5543ded..9feccd0 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1406,9 +1406,15 @@ panic_stackshot_release_lock(void)
 	DebuggerUnlock();
 }
 
+/* k27 diagnostics: panic-spin=1 keeps the panicked VM as it is (no restart) so the panic region can be read from the host */
+static TUNABLE(bool, virt_panic_spin, "panic-spin", false);
+
 static void
 kdp_machine_reboot_type(unsigned int type, uint64_t debugger_flags)
 {
+	if (virt_panic_spin && type == kPEPanicRestartCPU) {
+		panic_spin_forever();
+	}
 	if ((type == kPEPanicRestartCPU) && (debugger_flags & DEBUGGER_OPTION_SKIP_PANICEND_CALLOUTS)) {
 		PEHaltRestart(kPEPanicRestartCPUNoCallouts);
