 /// Refuse a MoltenVK device of `description` running without Metal argument buffers
 /// (`argument_buffers.rs`).
+/// The global priority METAL2VULKAN_QUEUE_PRIORITY asks for (low, medium, high, realtime) and the
+/// name of the extension `physical` offers it through (VK_KHR_global_priority, or the EXT);
+/// `None` without either.
+fn queue_global_priority(
+    instance: &InstanceShared,
+    physical: vk::PhysicalDevice,
+) -> Option<(vk::QueueGlobalPriorityKHR, &'static CStr)> {
+    let priority = match std::env::var("METAL2VULKAN_QUEUE_PRIORITY").ok()?.as_str() {
+        "low" => vk::QueueGlobalPriorityKHR::LOW,
+        "medium" => vk::QueueGlobalPriorityKHR::MEDIUM,
+        "high" => vk::QueueGlobalPriorityKHR::HIGH,
+        "realtime" => vk::QueueGlobalPriorityKHR::REALTIME,
+        _ => return None,
+    };
+    // SAFETY: `physical` was enumerated from the instance.
+    let offered = unsafe { instance.raw.enumerate_device_extension_properties(physical) }.ok()?;
+    [c"VK_KHR_global_priority", c"VK_EXT_global_priority"]
+        .into_iter()
+        .find(|name| offered.iter().any(|e| e.extension_name_as_c_str() == Ok(*name)))
+        .map(|name| (priority, name))
+}
