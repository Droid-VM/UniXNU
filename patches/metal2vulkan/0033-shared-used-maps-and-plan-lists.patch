diff --git a/crates/metal2vulkan/src/bind/shared_list.rs b/crates/metal2vulkan/src/bind/shared_list.rs
new file mode 100644
index 000000000..401e9fce0
--- /dev/null
+++ b/crates/metal2vulkan/src/bind/shared_list.rs
@@ -0,0 +1,174 @@
+//! [`SharedList`]: a plan's list that the plans stating the same one share.
+//!
+//! A plan's descriptor writes, resource uses and heap members list every resource its shape
+//! names as used (`BindShape::used`): an encoder's whole resident set, for a draw that reaches
+//! its resources through the handle table. The plans of one encoder's shapes (one per bound
+//! buffer length class and variant) list the same resources alike, and a consumer keeps each
+//! plan it memoizes; held apart, each would cost the consumer the encoder's resources again.
+//! [`BindingPlan::share_lists`](super::BindingPlan::share_lists) has a plan hold the very list
+//! another live plan holds where they are equal: found by content among the long lists made so
+//! far that something still holds ([`interned`](SharedList::interned)).
+
+use std::any::{Any, TypeId};
+use std::collections::HashMap;
+use std::hash::{Hash, Hasher};
+use std::sync::{Arc, Mutex, Weak};
+
+/// A list a plan states, shared by reference: a clone is the same list, compared, hashed and
+/// serialized as its items; a change through `DerefMut` makes it a list of its own.
+pub struct SharedList<T>(Arc<Vec<T>>);
+
+/// The shortest list [`SharedList::interned`] looks for among the others: a shorter one costs
+/// less than looking.
+const INTERNED_FROM: usize = 64;
+
+/// The long lists made so far, by item type and content hash, held weakly: a list lives as long
+/// as a plan holds it.
+type Table = HashMap<(TypeId, u64), Vec<Weak<dyn Any + Send + Sync>>>;
+static INTERNED: Mutex<Option<(Table, usize)>> = Mutex::new(None);
+
+impl<T> SharedList<T> {
+    /// Whether `other` is this very list (not only an equal one).
+    pub fn same(&self, other: &SharedList<T>) -> bool {
+        Arc::ptr_eq(&self.0, &other.0)
+    }
+}
+
+impl<T: Hash + Eq + Send + Sync + 'static> SharedList<T> {
+    /// This list, or an equal one a live plan holds: a list of [`INTERNED_FROM`] items or more
+    /// found by its content among those this made, else kept to be found.
+    pub fn interned(self) -> SharedList<T> {
+        if self.0.len() < INTERNED_FROM {
+            return self;
+        }
+        let mut hasher = std::hash::DefaultHasher::new();
+        self.0.hash(&mut hasher);
+        let key = (TypeId::of::<T>(), hasher.finish());
+        let mut table = INTERNED
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        let (table, made) = table.get_or_insert_with(Default::default);
+        let kept = table.entry(key).or_default();
+        kept.retain(|list| list.strong_count() > 0);
+        for list in kept.iter() {
+            let Some(list) = list.upgrade() else { continue };
+            if let Ok(list) = list.downcast::<Vec<T>>() {
+                if *list == *self.0 {
+                    return SharedList(list);
+                }
+            }
+        }
+        let weak: Weak<dyn Any + Send + Sync> = Arc::downgrade(&self.0) as Weak<_>;
+        kept.push(weak);
+        // Now and then, the entries of the lists no plan holds any more.
+        *made += 1;
+        if *made % 1024 == 0 {
+            table.retain(|_, kept| {
+                kept.retain(|list| list.strong_count() > 0);
+                !kept.is_empty()
+            });
+        }
+        self
+    }
+}
+
+impl<T> Clone for SharedList<T> {
+    fn clone(&self) -> SharedList<T> {
+        SharedList(Arc::clone(&self.0))
+    }
+}
+
+impl<T> Default for SharedList<T> {
+    fn default() -> SharedList<T> {
+        SharedList(Arc::new(Vec::new()))
+    }
+}
+
+impl<T> From<Vec<T>> for SharedList<T> {
+    fn from(items: Vec<T>) -> SharedList<T> {
+        SharedList(Arc::new(items))
+    }
+}
+
+impl<T> std::ops::Deref for SharedList<T> {
+    type Target = Vec<T>;
+    fn deref(&self) -> &Vec<T> {
+        &self.0
+    }
+}
+
+impl<T: Clone> std::ops::DerefMut for SharedList<T> {
+    fn deref_mut(&mut self) -> &mut Vec<T> {
+        Arc::make_mut(&mut self.0)
+    }
+}
+
+impl<'a, T> IntoIterator for &'a SharedList<T> {
+    type Item = &'a T;
+    type IntoIter = std::slice::Iter<'a, T>;
+    fn into_iter(self) -> Self::IntoIter {
+        self.0.iter()
+    }
+}
+
+impl<T: PartialEq> PartialEq for SharedList<T> {
+    fn eq(&self, other: &SharedList<T>) -> bool {
+        Arc::ptr_eq(&self.0, &other.0) || *self.0 == *other.0
+    }
+}
+
+impl<T: Eq> Eq for SharedList<T> {}
+
+impl<T: Hash> Hash for SharedList<T> {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.0.hash(state);
+    }
+}
+
+impl<T: std::fmt::Debug> std::fmt::Debug for SharedList<T> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.0.fmt(f)
+    }
+}
+
+#[cfg(feature = "serde")]
+impl<T: serde::Serialize> serde::Serialize for SharedList<T> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        self.0.serialize(serializer)
+    }
+}
+
+#[cfg(feature = "serde")]
+impl<'de, T: serde::Deserialize<'de>> serde::Deserialize<'de> for SharedList<T> {
+    fn deserialize<D: serde::Deserializer<'de>>(
+        deserializer: D,
+    ) -> Result<SharedList<T>, D::Error> {
+        Vec::deserialize(deserializer).map(SharedList::from)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::SharedList;
+
+    #[test]
+    fn equal_long_lists_are_one() {
+        let a = SharedList::from((0..100u32).collect::<Vec<_>>()).interned();
+        let b = SharedList::from((0..100u32).collect::<Vec<_>>()).interned();
+        assert!(a.same(&b));
+        let short = SharedList::from(vec![1u32, 2]).interned();
+        let again = SharedList::from(vec![1u32, 2]).interned();
+        assert!(!short.same(&again) && short == again);
+        let mut changed = b.clone();
+        changed.push(7);
+        assert!(!changed.same(&a) && a.len() == 100 && changed.len() == 101);
+    }
+
+    #[test]
+    fn a_list_no_plan_holds_is_made_again() {
+        let first = SharedList::from((0..80u64).map(|i| i * 3).collect::<Vec<_>>()).interned();
+        drop(first);
+        let second = SharedList::from((0..80u64).map(|i| i * 3).collect::<Vec<_>>()).interned();
+        assert!(second.len() == 80 && second[79] == 237);
+    }
+}
