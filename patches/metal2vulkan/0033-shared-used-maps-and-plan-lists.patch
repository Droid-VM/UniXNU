+/// A shape's used resources by consumer token ([`BindShape::used`]), shared: a clone is a
+/// reference to the same map, which an encoder's draws, a state's settled shapes and the plans
+/// memoized under them hold once (a map lists every resource an encoder made resident, so a copy
+/// of each would cost each holder the encoder's resources). Its hash is made once, and its form
+/// with every texture at one level ([`BindShape::for_plan`]) once. Compared, hashed and ordered
+/// as the map; a change through `DerefMut` makes it a map of its own.
+#[derive(Clone, Default)]
+pub struct UsedShapes(std::sync::Arc<UsedInner>);
+
+#[derive(Default)]
+struct UsedInner {
+    map: BTreeMap<u32, UsedShape>,
+    hash: std::sync::OnceLock<u64>,
+    one_level: std::sync::OnceLock<UsedShapes>,
+}
+
+impl Clone for UsedInner {
+    fn clone(&self) -> UsedInner {
+        UsedInner {
+            map: self.map.clone(),
+            ..UsedInner::default()
+        }
+    }
+}
+
+impl UsedShapes {
+    /// The shared form of `map`.
+    pub fn new(map: BTreeMap<u32, UsedShape>) -> UsedShapes {
+        UsedShapes(std::sync::Arc::new(UsedInner {
+            map,
+            ..UsedInner::default()
+        }))
+    }
+
+    /// Whether `other` is this very map (not only an equal one).
+    pub fn same(&self, other: &UsedShapes) -> bool {
+        std::sync::Arc::ptr_eq(&self.0, &other.0)
+    }
+
+    /// The map's hash, made once.
+    fn digest(&self) -> u64 {
+        *self.0.hash.get_or_init(|| {
+            use std::hash::{Hash, Hasher};
+            let mut hasher = std::hash::DefaultHasher::new();
+            self.0.map.hash(&mut hasher);
+            hasher.finish()
+        })
+    }
+
+    /// The map with every texture at one level ([`TextureShape::at_one_level`]), made once:
+    /// itself where no texture has more.
+    pub(crate) fn at_one_level(&self) -> UsedShapes {
+        let more = |shape: &UsedShape| {
+            matches!(
+                shape.class,
+                UsedClass::Texture(TextureShape::Texture { mipmap_level_count, .. })
+                    if mipmap_level_count != 1
+            )
+        };
+        if !self.0.map.values().any(more) {
+            return self.clone();
+        }
+        let projected = self.0.one_level.get_or_init(|| {
+            let mut map = self.0.map.clone();
+            for shape in map.values_mut() {
+                if let UsedClass::Texture(texture) = &mut shape.class {
+                    *texture = texture.at_one_level();
+                }
+            }
+            UsedShapes::new(map)
+        });
+        projected.clone()
+    }
+}
+
+impl From<BTreeMap<u32, UsedShape>> for UsedShapes {
+    fn from(map: BTreeMap<u32, UsedShape>) -> UsedShapes {
+        UsedShapes::new(map)
+    }
+}
+
+impl std::ops::Deref for UsedShapes {
+    type Target = BTreeMap<u32, UsedShape>;
+    fn deref(&self) -> &BTreeMap<u32, UsedShape> {
+        &self.0.map
+    }
+}
+
+impl std::ops::DerefMut for UsedShapes {
+    fn deref_mut(&mut self) -> &mut BTreeMap<u32, UsedShape> {
+        let inner = std::sync::Arc::make_mut(&mut self.0);
+        inner.hash = std::sync::OnceLock::new();
+        inner.one_level = std::sync::OnceLock::new();
+        &mut inner.map
+    }
+}
+
+impl<'a> IntoIterator for &'a UsedShapes {
+    type Item = (&'a u32, &'a UsedShape);
+    type IntoIter = std::collections::btree_map::Iter<'a, u32, UsedShape>;
+    fn into_iter(self) -> Self::IntoIter {
+        self.0.map.iter()
+    }
+}
+
+impl PartialEq for UsedShapes {
+    fn eq(&self, other: &UsedShapes) -> bool {
+        self.same(other)
+            || (self.0.map.len() == other.0.map.len()
+                && self.digest() == other.digest()
+                && self.0.map == other.0.map)
+    }
+}
+
+impl Eq for UsedShapes {}
+
+impl PartialOrd for UsedShapes {
+    fn partial_cmp(&self, other: &UsedShapes) -> Option<std::cmp::Ordering> {
+        Some(self.cmp(other))
+    }
+}
+
+impl Ord for UsedShapes {
+    fn cmp(&self, other: &UsedShapes) -> std::cmp::Ordering {
+        match self.same(other) {
+            true => std::cmp::Ordering::Equal,
+            false => self.0.map.cmp(&other.0.map),
+        }
+    }
+}
+
+impl std::hash::Hash for UsedShapes {
+    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+        state.write_u64(self.digest());
+    }
+}
