+#[cfg(feature = "serde")]
+impl<'de> serde::Deserialize<'de> for UsedShapes {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<UsedShapes, D::Error> {
+        BTreeMap::deserialize(deserializer).map(UsedShapes::new)
+    }
+}
