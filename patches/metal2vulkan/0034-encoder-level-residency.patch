+/// texture's, its key named (and out of `reaching`, into `unnamed`). Their stages.
+fn push_apart(
+    reach: ResidentReach,
+    residency: &Residency,
+    tokens: std::ops::Range<usize>,
+    tables: &Tables<'_>,
+    into: &mut CommandUses,
+    (added, unnamed): (&mut Vec<ResourceKey>, &mut Vec<ResourceKey>),
+) -> Result<(vk::PipelineStageFlags2, vk::PipelineStageFlags2), Error> {
