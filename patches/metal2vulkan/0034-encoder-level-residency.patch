+    last: (u64, usize),
+}
+
+impl ResidentLogs {
+    /// Where a draw's uses of what the encoder made resident, the first `prefix.len` of `uses`,
+    /// lie in a log: the log whose last uses are theirs, or whose last uses they extend (the log
+    /// extended), else a log made of them. `None` where the encoder keeps as many logs as it
+    /// may: the draw's are gathered as they are.
+    pub(super) fn log(
+        &mut self,
+        (uses, prefix): (&[Use<ResourceKey>], ResidentPrefix),
+    ) -> Option<(usize, usize)> {
+        let at = (self.logs.iter())
+            .position(|log| prefix.past(Some(log.last)) == log.last.1 && log.last.1 > 0);
+        let at = match at {
+            Some(at) => at,
+            None if self.logs.len() < RESIDENT_LOGS => {
+                self.logs.push(ResidentLog {
+                    uses: Vec::new(),
+                    last: (0, 0),
+                });
