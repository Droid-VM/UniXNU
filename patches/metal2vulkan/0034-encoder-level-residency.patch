+    for token in tokens {
+        let used = residency.used_resource(token as u32);
+        for resource in reach.uses_of_resource(&used) {
+            let Some(made) = resident_use(&resource, tables)? else {
+                continue;
+            };
+            all |= made.0.read.stages | made.0.write.stages;
+            writes |= made.0.write.stages;
+            let key = made.0.key;
+            match made.1 {
+                true => {
+                    if into.resident_named.insert(key) && into.reaching.remove(&key) {
+                        unnamed.push(key);
