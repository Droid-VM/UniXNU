+
+/// How a plan's functions reach a resource their encoder made resident ([`BindingPlan::resident`]):
+/// a buffer where a function reads the resident root table (`pointer`), a texture where one
+/// resolves handles (`handle`), a heap where either does; in the pipeline stages its render
+/// stages name of those the pipeline has (`render`, by vertex, fragment, object and mesh), or a
+/// compute plan's kernel whatever they are (`every`); writing in the stages whose function may
+/// write memory alone (`writers`).
+#[non_exhaustive]
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize, serde::Deserialize))]
+pub struct ResidentReach {
+    pub pointer: bool,
+    pub handle: bool,
+    pub render: [vk::PipelineStageFlags2; 4],
+    pub every: vk::PipelineStageFlags2,
+    pub writers: vk::PipelineStageFlags2,
+}
+
+impl ResidentReach {
+    /// The pipeline stages a used resource made resident for the render stages `stages` reaches.
+    pub fn stages(&self, stages: metal::RenderStages) -> vk::PipelineStageFlags2 {
+        if !self.every.is_empty() {
+            return self.every;
+        }
+        let flags = [
+            metal::RenderStages::VERTEX,
+            metal::RenderStages::FRAGMENT,
+            metal::RenderStages::OBJECT,
+            metal::RenderStages::MESH,
+        ];
+        (flags.iter().zip(self.render)).fold(vk::PipelineStageFlags2::empty(), |all, (f, s)| {
+            match stages.contains(*f) {
+                true => all | s,
+                false => all,
+            }
+        })
+    }
+
+    /// The uses a plan lists of the used resource `token` of shape `used` (none where its
+    /// functions reach it in no stage; a write in the stages whose function may write memory, a
+    /// read in the others, where its usage writes): `BindShape::used`'s, in its order.
+    pub fn uses_of(&self, token: u32, used: &UsedShape) -> impl Iterator<Item = ResourceUse> {
+        let reachable = match used.class {
+            UsedClass::Buffer => self.pointer,
+            UsedClass::Texture(_) => self.handle,
+            UsedClass::Heap => self.pointer || self.handle,
+        };
+        let stages = self.stages(used.stages);
+        let read =
+            (used.usage).intersects(metal::ResourceUsage::READ | metal::ResourceUsage::SAMPLE);
+        let write = used.usage.contains(metal::ResourceUsage::WRITE);
+        let access = match (read, write) {
+            (false, false) => AccessSet::READ_WRITE,
+            (read, write) => AccessSet { read, write },
+        };
+        let class = match used.class {
+            UsedClass::Texture(_) if write => AccessClass::StorageImage,
+            UsedClass::Texture(_) => AccessClass::Sampled,
+            UsedClass::Buffer | UsedClass::Heap => AccessClass::Storage,
+        };
+        let (writing, reading) = match access.write {
+            true => (
+                stages.intersection(self.writers),
+                vk::PipelineStageFlags2::from_raw(stages.as_raw() & !self.writers.as_raw()),
+            ),
+            false => (stages, vk::PipelineStageFlags2::empty()),
+        };
+        let reached = reachable && !stages.is_empty();
+        [(writing, access), (reading, AccessSet::READ)]
+            .into_iter()
+            .filter(move |(stages, _)| reached && !stages.is_empty())
+            .map(move |(stages, access)| ResourceUse {
+                resource: UseTarget::Used(token),
+                access,
+                class,
+                stages,
+                range: None,
+            })
+    }
+
+    /// [`uses_of`](Self::uses_of) a used resource as a bind state lists it.
+    pub fn uses_of_resource(&self, used: &UsedResource) -> impl Iterator<Item = ResourceUse> {
+        self.uses_of(used.token, &UsedShape::of(used))
+    }
 }
 
