+
+/// The most room [`keep_room`] keeps in a pool: half of the pool's next block, or
+/// `METAL2VULKAN_KEEP_ROOM_MIB` MiB where the process sets fewer. The room is one free range, so
+/// a pool whose blocks had the bytes only in pieces made another block for it: an iPadOS guest's
+/// render server held 536 MiB of pooled blocks for 280 MiB placed in them, every block wired guest
+/// memory. A pooled placement past the room, in an encoding, makes its block then.
+fn keep_room_cap() -> u64 {
+    (std::env::var("METAL2VULKAN_KEEP_ROOM_MIB").ok())
+        .and_then(|text| text.trim().parse::<u64>().ok())
+        .and_then(|mib| mib.checked_mul(1 << 20))
+        .unwrap_or(u64::MAX)
 }
 
