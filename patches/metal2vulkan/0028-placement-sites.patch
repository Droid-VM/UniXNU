+
+thread_local! {
+    /// The outermost asking place of this thread's allocations ([`AskedSite::enter`]), which goes
+    /// before the place `#[track_caller]` carries: a closure between a purpose and its allocation
+    /// stops the latter there.
+    static ASKED: std::cell::Cell<Option<&'static std::panic::Location<'static>>> =
+        const { std::cell::Cell::new(None) };
+}
+
+/// The asking place of a purpose's allocations while it lives: its entry's caller (the entry
+/// marked `#[track_caller]`), unless an outer entry of the thread named one first.
+pub(super) struct AskedSite(bool);
+
+impl AskedSite {
+    #[track_caller]
+    pub(super) fn enter() -> AskedSite {
+        let site = std::panic::Location::caller();
+        ASKED.with(|asked| match asked.get() {
+            Some(_) => AskedSite(false),
+            None => {
+                asked.set(Some(site));
+                AskedSite(true)
+            }
+        })
+    }
+}
+
+impl Drop for AskedSite {
+    fn drop(&mut self) {
+        if self.0 {
+            ASKED.with(|asked| asked.set(None));
+        }
+    }
+}
+
+/// The live placements in the runtime's blocks by where they were asked for ([`Placement`]'s
+/// `site`): bytes and count per source line, in every device of the process.
+static SITES: Mutex<Vec<(&'static std::panic::Location<'static>, i64, i64)>> = Mutex::new(Vec::new());
+
+fn sites_add(site: &'static std::panic::Location<'static>, bytes: i64) {
+    let mut sites = SITES.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+    let count = bytes.signum();
+    match sites.iter_mut().find(|(at, _, _)| *at == site) {
+        Some(entry) => {
+            entry.1 += bytes;
+            entry.2 += count;
+        }
+        None => sites.push((site, bytes, count)),
+    }
+}
+
+/// DroidVM diagnostic: the process's live placements by place, most bytes first, into `out`
+/// (`size` bytes, NUL-terminated): one line each, "site MiB count file:line", at most 32. What a
+/// process's GPU memory holds beyond its own resources is the runtime's (shadows, twins, staging),
+/// and the place says which. The bytes written, without the NUL.
+#[unsafe(no_mangle)]
+pub extern "C" fn m2v_placement_sites(out: *mut u8, size: usize) -> usize {
+    if out.is_null() || size == 0 {
+        return 0;
+    }
+    let mut sites: Vec<(&'static std::panic::Location<'static>, i64, i64)> =
+        SITES.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).clone();
+    sites.retain(|(_, bytes, _)| *bytes > 0);
+    sites.sort_by(|a, b| b.1.cmp(&a.1));
+    let mut text = String::new();
+    for (site, bytes, count) in sites.iter().take(32) {
+        let file = site.file();
+        let file = file.rfind("src/").map_or(file, |at| &file[at + 4..]);
+        text.push_str(&format!("site {:.2} {} {}:{}\n", *bytes as f64 / 1048576.0, count, file, site.line()));
+    }
+    let length = text.len().min(size - 1);
+    // SAFETY: the caller's `size` bytes at `out`.
+    unsafe {
+        std::ptr::copy_nonoverlapping(text.as_ptr(), out, length);
+        *out.add(length) = 0;
+    }
+    length
+}
