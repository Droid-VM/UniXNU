+
+    /// Whether it backs `own`, or covers it: of its kind ([`grows_for`](Self::grows_for)) and at
+    /// least as wide and as high. A pass renders a memoryless color only inside its own extent,
+    /// the framebuffer's (whose views need only be at least as large, `render_target.rs`), and
+    /// reads nothing a pass before it left (the [`pooled_backing`] docs): so one image serves an
+    /// attachment of any extent it holds. DroidVM: Core Animation's memoryless targets come in
+    /// as many extents as its blurs and backdrops, each kept apart: the iPadOS guest's render
+    /// server held 19 backings, 254 MiB (the pool's bound), every one wired guest memory.
+    fn covers(&self, own: &Target) -> bool {
+        self.backs(own)
+            || (self.grows_for(own)
+                && self.extent[0] >= own.extent[0]
+                && self.extent[1] >= own.extent[1])
+    }
+
+    /// Whether a backing of `own`'s kind may be made at this one's extent: the same pixel format,
+    /// format and layers, one sample. A multisampled backing keeps its exact extent (the sample
+    /// planes' copies and the color resolve read it whole).
+    fn grows_for(&self, own: &Target) -> bool {
+        self.pixel_format == own.texture.pixel_format()
+            && self.format == own.format
+            && self.samples == 1
+            && own.samples == 1
+            && self.layers == own.layers
+    }
 }
 
