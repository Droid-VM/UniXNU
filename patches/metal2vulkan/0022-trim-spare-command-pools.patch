+    /// Release the spare command pools of `device` kept spares for `idle` or longer, all but the
+    /// `floor` newest (the module docs): how many went. Nothing of a spare is pending; a primary
+    /// begun ahead in one is recording nothing.
+    pub(super) fn trim_command_pools(&self, device: &DeviceShared, idle: Duration, floor: usize) -> usize {
+        let now = Instant::now();
+        let stale: Vec<CommandPool> = {
+            let mut pools = lock(&self.command_pools);
+            let oldest = pools.len().saturating_sub(floor);
+            let newest = pools.split_off(oldest);
+            let (stale, fresh): (Vec<CommandPool>, Vec<CommandPool>) = pools
+                .drain(..)
+                .partition(|pool| pool.kept.is_some_and(|kept| now.saturating_duration_since(kept) >= idle));
+            pools.extend(fresh);
+            pools.extend(newest);
+            stale
+        };
+        let count = stale.len();
+        for pool in stale {
+            // SAFETY: a spare's command buffers are none of them pending (`give_command_pool`), and
+            // it is out of the spares, so no command buffer takes it.
+            unsafe { release_in_section(device, pool.raw) };
         }
+        count
     }
 
