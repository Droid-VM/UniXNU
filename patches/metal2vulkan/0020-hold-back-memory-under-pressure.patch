+/// Hold `memory` back while `on` ([`Memory::hold_back`]): turning it on frees the blocks made
+/// ahead, those still being made stopped, each waited for with the lock released (its making
+/// reads its pages), and freed. How many went.
+pub(super) fn hold_back(memory: &Mutex<Memory>, device: &ash::Device, on: bool) -> usize {
+    let (mut count, making) = lock(memory).hold_back(device, on);
+    for readying in making {
+        for block in readying.stop() {
+            count += 1;
+            // SAFETY: nothing is placed in a block made ahead, and no command reads it.
+            drop(unsafe { lock(memory).let_go(device, block, FreeCause::KeptForRoom, None) });
+        }
+    }
+    count
