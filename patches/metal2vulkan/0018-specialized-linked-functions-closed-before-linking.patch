+/// `code` closed for linking `f` in a copy of its module: the function-constant values `f` was
+/// specialized with bound, and its static initializers evaluated into constant initializers, as
+/// the stage's own module is before inlining (`specialize_dynamic`, steps 3 and 4). That is what a
+/// specialized `MTLFunction` whose module declares constants links (Metal resolves them before
+/// linking; [`plan`]). `f` comes back with no values left to bind. `Ok(None)` when the module has
+/// neither, or declares a constant `f` has no value for (refused by [`plan`] as before);
+/// `Ok(Err(refusal))` when the values do not fit or an initializer does not evaluate; an outer
+/// error for a budget stop. iPadOS 27's RenderBox links `displacementMap_v1`, specialized with
+/// `RB::shaderVariant` and initializing its constant tables statically, as `custom_fn` (the icon
+/// effects of Settings' rows, drawn in iconservicesagent).
+fn bound_constants(
+    code: &LinkedCode,
+    f: &LinkedName,
+    m: &mut Meter,
+) -> Result<Result<Option<(LinkedCode, LinkedName)>, Error>, Error> {
+    let declared = &code.abi.function_constants;
+    let Ok(values) = &f.constants else {
+        return Ok(Ok(None));
+    };
+    if declared.is_empty() && !static_initializer(code) {
+        return Ok(Ok(None));
+    }
+    if declared.iter().any(|d| !values.contains_key(&d.index)) {
+        return Ok(Ok(None));
+    }
+    // A static initializer is not a function a stage calls: linked as one, it stays refused.
+    let parts = code.module.parts();
+    let root_initializes = parts.funcs.values().any(|func| {
+        func.section == Some(Section::StaticInit)
+            && parts.symbols.get(func.name) == Some(&*f.symbol)
+    });
+    if root_initializes {
+        return Ok(Ok(None));
+    }
+    let stop = |e: &Error| {
+        matches!(
+            e,
+            Error::Budget(_) | Error::Cancelled | Error::LimitExceeded(_)
+        )
+    };
+    let (pending, states) = match super::fc::check(&code.module, &code.abi, values, m) {
+        Ok(checked) => checked,
+        Err(e) if stop(&e) => return Err(e),
+        Err(refusal) => return Ok(Err(refusal)),
+    };
+    let mut parts = code.module.clone().into_parts();
+    let closed = super::fc::bind(
+        &parts.types,
+        &mut parts.consts,
+        &mut parts.globals,
+        &pending,
+        m,
+    )
+    .and_then(|()| {
+        let unevaluable = super::static_init::Unevaluable::Refuse;
+        super::static_init::evaluate(&mut parts, &states, unevaluable, m)
+    });
+    match closed {
+        Ok(_) => {}
+        Err(e) if stop(&e) => return Err(e),
+        Err(refusal) => return Ok(Err(refusal)),
+    }
+    // What the initializers stored is in the globals' initializers now: nothing runs them, and
+    // each is left a declaration (which only external linkage may be).
+    for func in parts.funcs.values_mut() {
+        if func.section == Some(Section::StaticInit) {
+            func.body = None;
+            func.linkage = Linkage::External;
+        }
+    }
+    let module = Module::new(parts, m)?;
+    let mut abi = code.abi.clone();
+    abi.function_constants.clear();
+    let f = LinkedName {
+        constants: Ok(BTreeMap::new()),
+        ..f.clone()
+    };
+    Ok(Ok(Some((LinkedCode { module, abi }, f))))
+}
