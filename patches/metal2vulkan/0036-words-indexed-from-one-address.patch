+/// A byte offset `o` (a `u64`) from a 4-aligned device address, as a word memory takes it (module
+/// doc, *Word places*).
+#[derive(Clone, Copy, Debug)]
+pub struct Split {
+    /// The address plus `o`'s 4 GiB page (a `u64`, 4-aligned).
+    pub page: Value,
+    /// The word index `u32(o) >> 2` (a `u32`).
+    pub word: Value,
+    /// The byte offset `u32(o) & 3` within that word (a `u32`).
+    pub low: Value,
+}
+
+/// Split offset `off` (a `u64`) from the 4-aligned device address `host` (a `u64`).
+pub fn split(fb: &mut FunctionBuilder<'_>, host: Value, off: Value) -> BResult<Split> {
+    let pages = k64(fb, !0xFFFF_FFFF)?;
+    let high = fb.binary(BinOp::BitwiseAnd, off, pages)?;
+    let page = fb.binary(BinOp::IAdd, host, high)?;
+    let u32_ = fb.module().ty(Type::Int {
+        width: 32,
+        signed: false,
+    })?;
+    let low = fb.convert(ConvOp::UConvert, off, u32_)?;
+    let two = k32(fb, 2)?;
+    let word = fb.binary(BinOp::ShiftRightLogical, low, two)?;
+    let three = k32(fb, 3)?;
+    let low = fb.binary(BinOp::BitwiseAnd, low, three)?;
+    Ok(Split { page, word, low })
+}
+
+impl Split {
+    /// The split of a contained access: `sink`'s word 0 unless `inb`.
+    pub fn contained(self, fb: &mut FunctionBuilder<'_>, inb: Value, sink: Value) -> BResult<Split> {
+        let zero = k32(fb, 0)?;
+        Ok(Split {
+            page: fb.select(inb, self.page, sink)?,
+            word: fb.select(inb, self.word, zero)?,
+            low: fb.select(inb, self.low, zero)?,
+        })
+    }
+}
+
+/// A `u32` constant.
+fn k32(fb: &mut FunctionBuilder<'_>, v: u32) -> BResult<Value> {
+    let c = fb.u32_const(v)?;
+    fb.module().const_value(c)
+}
