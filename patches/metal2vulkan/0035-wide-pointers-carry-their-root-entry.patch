+/// A read-only device place is a place of the same pointee through a block of its own, the one
+/// whose layout says `non_writable`: the writable place over the same pointee keeps the other.
+#[test]
+fn read_only_device_places_are_blocks_of_their_own() {
+    in_fn(|f, t| {
+        let a64 = p(f, t.u64_);
+        let block_of = |f: &mut FunctionBuilder<'_>, place: Value| -> (TypeId, bool) {
+            let Inst::AccessChain { base, .. } = def_of(f, place) else {
+                panic!("a place is an access chain");
+            };
+            let ptr = ty(f, base);
+            let Ok(Type::Pointer { pointee, .. }) = f.mb().types().get(ptr) else {
+                panic!("a place's base is a pointer");
+            };
+            let Ok(Type::Struct {
+                layout: Some(l), ..
+            }) = f.mb().types().get(*pointee)
+            else {
+                panic!("a place's base points to a block");
+            };
+            (ptr, l.non_writable)
+        };
+        let writable = f.device_place(a64, t.u64_).expect("place");
+        let read_only = f.device_place_read_only(a64, t.u64_).expect("read-only place");
+        assert_eq!(ty(f, read_only), ty(f, writable));
+        let (w, w_flag) = block_of(f, writable);
+        let (r, r_flag) = block_of(f, read_only);
+        assert_ne!(w, r);
+        assert!(!w_flag && r_flag);
+        // Another read-only place over the same pointee is the same block.
+        let again = f.device_place_read_only(a64, t.u64_).expect("read-only place");
+        assert_eq!(block_of(f, again), (r, true));
+    });
+}
