+
+/// Diagnostic (DroidVM): while /private/var/ngpu/debug/full-barriers exists when the process starts, every render pass, copy,
+/// blit, image clear, buffer fill or update and dispatch is preceded by a full memory barrier -- every command's writes made
+/// visible to every later access -- the A/B for a dependency missing between a pass and a later read of what it rendered
+/// (CoreAnimation's material backdrops blurred an empty capture under the dock now and then).
+static FULL_BARRIERS: std::sync::LazyLock<bool> =
+    std::sync::LazyLock::new(|| std::path::Path::new("/private/var/ngpu/debug/full-barriers").exists());
+
+/// Whether [`FULL_BARRIERS`] puts a barrier before `command`: the commands that begin work outside a render pass.
+fn barriered(command: Command) -> bool {
+    matches!(
+        command,
+        Command::CmdBeginRenderPass
+            | Command::CmdDispatch
+            | Command::CmdDispatchIndirect
+            | Command::CmdCopyBuffer
+            | Command::CmdCopyImage
+            | Command::CmdBlitImage
+            | Command::CmdCopyBufferToImage
+            | Command::CmdCopyImageToBuffer
+            | Command::CmdClearColorImage
+            | Command::CmdClearDepthStencilImage
+            | Command::CmdFillBuffer
+            | Command::CmdUpdateBuffer
+    )
+}
+
+/// A full memory barrier into `command_buffer` through slot `S`'s driver (`FULL_BARRIERS`).
+///
+/// # Safety
+///
+/// `command_buffer` is recording, outside a render pass, on slot `S`'s device.
+unsafe fn full_barrier<const S: usize>(command_buffer: vk::CommandBuffer) {
+    let real = REAL.cmd_pipeline_barrier[S].load(Ordering::Acquire);
+    if real.is_null() {
+        return;
+    }
+    let barrier = vk::MemoryBarrier::default()
+        .src_access_mask(vk::AccessFlags::MEMORY_WRITE)
+        .dst_access_mask(vk::AccessFlags::MEMORY_READ | vk::AccessFlags::MEMORY_WRITE);
+    // SAFETY: the slot's device's driver gave vkCmdPipelineBarrier (`store`), of this signature.
+    unsafe {
+        let real = std::mem::transmute::<
+            *mut c_void,
+            unsafe extern "system" fn(
+                vk::CommandBuffer,
+                vk::PipelineStageFlags,
+                vk::PipelineStageFlags,
+                vk::DependencyFlags,
+                u32,
+                *const vk::MemoryBarrier<'_>,
+                u32,
+                *const vk::BufferMemoryBarrier<'_>,
+                u32,
+                *const vk::ImageMemoryBarrier<'_>,
+            ),
+        >(real);
+        real(
+            command_buffer,
+            vk::PipelineStageFlags::ALL_COMMANDS,
+            vk::PipelineStageFlags::ALL_COMMANDS,
+            vk::DependencyFlags::empty(),
+            1,
+            &barrier,
+            0,
+            std::ptr::null(),
+            0,
+            std::ptr::null(),
+        );
+    }
 }
 
