+/// `vkCmdCopyImageToBuffer2` and `vkCmdCopyBufferToImage2` with [`CopyRotation`] chained. Between the frame's image and the
+/// plane's bytes they replace the three steps of a turn (the bytes through the staging buffer, the kernel, the tight
+/// buffer, each after a full barrier), whose kernel reads one of its two linear buffers across its rows: a 1366x1024
+/// pass of CoreAnimation's rotated framebuffer cost 8.8 ms where an unrotated one took 0.5.
+#[derive(Clone, Copy)]
+pub(crate) struct TurnedCopyCommands {
+    to_buffer: vk::PFN_vkCmdCopyImageToBuffer2,
+    to_image: vk::PFN_vkCmdCopyBufferToImage2,
+}
+
+/// The board's Turnip's private structure (`tu_copy_rotation_droidvm`): chained to a copy's info, the 2D engine's
+/// rotation (`a6xx_rotation`), and the buffer an image of the region turned by it.
+#[repr(C)]
+struct CopyRotation {
+    s_type: vk::StructureType,
+    p_next: *const c_void,
+    rotation: u32,
+}
+
+const COPY_ROTATION: vk::StructureType = vk::StructureType::from_raw(1_000_999_001);
+const ROTATE_90: u32 = 1;
+const ROTATE_180: u32 = 2;
+const ROTATE_270: u32 = 3;
+
+/// The device's [`TurnedCopyCommands`]: on Turnip only, which the board builds with the structure (another driver would
+/// ignore it and copy unturned), and not while /private/var/ngpu/debug/rot-kernel exists when the process starts (the
+/// kernel's turns, for an A/B).
+///
+/// # Safety
+///
+/// `device` was made from `instance`. Turnip never writes its device's loader word (`loader_word.rs`: MoltenVK does), so
+/// `vkGetDeviceProcAddr` needs no restore first.
+pub(crate) unsafe fn turned_copy_commands(
+    instance: &ash::Instance,
+    device: &ash::Device,
+    driver: Option<DriverId>,
+) -> Option<TurnedCopyCommands> {
+    if driver != Some(DriverId::MESA_TURNIP)
+        || std::path::Path::new("/private/var/ngpu/debug/rot-kernel").exists()
+    {
+        return None;
+    }
+    let get = |names: [&CStr; 2]| {
+        names.into_iter().find_map(|name| {
+            // SAFETY: the caller's; a command the device does not have is null.
+            unsafe { instance.get_device_proc_addr(device.handle(), name.as_ptr()) }
+        })
+    };
+    let to_buffer = get([c"vkCmdCopyImageToBuffer2", c"vkCmdCopyImageToBuffer2KHR"])?;
+    let to_image = get([c"vkCmdCopyBufferToImage2", c"vkCmdCopyBufferToImage2KHR"])?;
+    // SAFETY: the device gave the commands of these names, whose core and KHR forms share their signatures.
+    unsafe {
+        Some(TurnedCopyCommands {
+            to_buffer: std::mem::transmute::<unsafe extern "system" fn(), vk::PFN_vkCmdCopyImageToBuffer2>(to_buffer),
+            to_image: std::mem::transmute::<unsafe extern "system" fn(), vk::PFN_vkCmdCopyBufferToImage2>(to_image),
+        })
+    }
+}
