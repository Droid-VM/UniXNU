 impl Memory {
+    /// DroidVM diagnostic: every pool with a block, one line each: "pool B|I<type> n<blocks> <MiB
+    /// placed>/<MiB>" then each block as <MiB>:<percent used>/<free ranges>/<longest free MiB>, a
+    /// dedicated one marked "d" (the idle trim keeps it, [`m2v_pool_report`]).
+    fn pool_report(&self) -> String {
+        let mut text = String::new();
+        for (at, pool) in self.pools.iter().enumerate() {
+            let blocks: Vec<&PoolBlock<Block>> = pool.blocks.iter().flatten().collect();
+            if blocks.is_empty() {
+                continue;
+            }
+            let holds = if at >= self.types.len() { 'I' } else { 'B' };
+            let size: u64 = blocks.iter().map(|b| b.ranges.len()).sum();
+            let used: u64 = blocks.iter().map(|b| b.ranges.used()).sum();
+            text.push_str(&format!("pool {}{} n{} {:.1}/{:.1}:", holds, at % self.types.len(), blocks.len(),
+                used as f64 / 1048576.0, size as f64 / 1048576.0));
+            for block in blocks {
+                let len = block.ranges.len().max(1);
+                text.push_str(&format!(" {:.1}{}:{}/{}/{:.1}", len as f64 / 1048576.0, if block.dedicated { "d" } else { "" },
+                    block.ranges.used() * 100 / len, block.ranges.range_count(),
+                    block.ranges.longest(1) as f64 / 1048576.0));
+            }
+            text.push('\n');
+        }
+        text
+    }
