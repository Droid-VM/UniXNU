 impl Memory {
+    /// DroidVM diagnostic: every pool with a block, one line each: "pool <kind><type> n<blocks>
+    /// <MiB placed>/<MiB>:" then each block as <MiB>:<percent used>/<free ranges>/<longest free
+    /// MiB>, a dedicated one marked "d" (the idle trim keeps it), the kind B buffers, I images, X
+    /// and D exportable buffers (opaque file descriptors, dma-bufs), F buffers of exportable
+    /// blocks, P buffers of the runtime's own pages; then each pool's blocks made ahead and not
+    /// yet in it, "ahead <kind><type> <MiB>" ([`m2v_pool_report`]).
+    fn pool_report(&self) -> String {
+        let kind = |holds: Holds| match holds {
+            Holds::Buffers => 'B',
+            Holds::Images => 'I',
+            Holds::Exports => 'X',
+            Holds::DmaBufs => 'D',
+            Holds::FdBuffers => 'F',
+            Holds::PageBuffers => 'P',
+        };
+        let types = self.types.len().max(1);
+        let mut text = String::new();
+        for (at, pool) in self.pools.iter().enumerate() {
+            let blocks: Vec<&PoolBlock<Block>> = pool.blocks.iter().flatten().collect();
+            if blocks.is_empty() {
+                continue;
+            }
+            let holds = Holds::ALL.get(at / types).copied().unwrap_or(Holds::Buffers);
+            let size: u64 = blocks.iter().map(|b| b.ranges.len()).sum();
+            let used: u64 = blocks.iter().map(|b| b.ranges.used()).sum();
+            text.push_str(&format!(
+                "pool {}{} n{} {:.1}/{:.1}:",
+                kind(holds),
+                at % types,
+                blocks.len(),
+                used as f64 / 1048576.0,
+                size as f64 / 1048576.0
+            ));
+            for block in blocks {
+                let len = block.ranges.len().max(1);
+                text.push_str(&format!(
+                    " {:.1}{}:{}/{}/{:.1}",
+                    len as f64 / 1048576.0,
+                    if block.dedicated { "d" } else { "" },
+                    block.ranges.used() * 100 / len,
+                    block.ranges.range_count(),
+                    block.ranges.longest(1) as f64 / 1048576.0
+                ));
+            }
+            text.push('\n');
+        }
+        for readying in &self.readying {
+            let (holds, type_index) = readying.pool();
+            text.push_str(&format!(
+                "ahead {}{} {:.1}\n",
+                kind(holds),
+                type_index,
+                readying.outstanding_bytes() as f64 / 1048576.0
+            ));
+        }
+        text
+    }
