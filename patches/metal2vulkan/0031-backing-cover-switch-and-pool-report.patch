+/// Whether the idle trim keeps a pool report (`METAL2VULKAN_POOL_REPORT=1`, DroidVM diagnostic).
+fn pool_report_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("METAL2VULKAN_POOL_REPORT").is_ok_and(|text| text.trim() == "1"))
+}
+
+/// The last pool report of the process's devices ([`Memory::pool_report`]).
+static POOL_REPORT: Mutex<String> = Mutex::new(String::new());
+
+/// DroidVM diagnostic: the last pool report into `out` (`size` bytes, NUL-terminated); the bytes
+/// written, without the NUL.
+#[unsafe(no_mangle)]
+pub extern "C" fn m2v_pool_report(out: *mut u8, size: usize) -> usize {
+    if out.is_null() || size == 0 {
+        return 0;
+    }
+    let report = POOL_REPORT.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).clone();
+    let length = report.len().min(size - 1);
+    // SAFETY: the caller's `size` bytes at `out`.
+    unsafe {
+        std::ptr::copy_nonoverlapping(report.as_ptr(), out, length);
+        *out.add(length) = 0;
+    }
+    length
+}
