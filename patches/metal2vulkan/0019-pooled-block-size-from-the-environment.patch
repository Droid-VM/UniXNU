 /// guest's home screen.
 pub(super) const FIRST_BLOCK_BYTES: u64 = 4 << 20;
 
+/// The size of a pooled block in this process: [`BLOCK_BYTES`], or `METAL2VULKAN_BLOCK_MIB` MiB
+/// where the process sets it (a power of two from [`FIRST_BLOCK_BYTES`] to [`BLOCK_BYTES`]). Where
+/// every block is wired guest memory, each pool's growth, the room [`keep_room`] keeps in it and
+/// the empty block it keeps are a block each: an iPadOS guest's render server held 547-616 MiB of
+/// empty pooled blocks at its home screen, and opening one app grew its pooled blocks by 640 MiB
+/// for 187 MiB placed in them (1.1 GiB of wired memory in a second, the guest's free pages at 0).
+/// A request larger than half a block takes a dedicated block of its own size, as before.
+fn block_bytes() -> u64 {
+    (std::env::var("METAL2VULKAN_BLOCK_MIB").ok())
+        .and_then(|text| text.trim().parse::<u64>().ok())
+        .and_then(|mib| mib.checked_mul(1 << 20))
+        .filter(|&bytes| bytes.is_power_of_two() && (FIRST_BLOCK_BYTES..=BLOCK_BYTES).contains(&bytes))
+        .unwrap_or(BLOCK_BYTES)
+}
