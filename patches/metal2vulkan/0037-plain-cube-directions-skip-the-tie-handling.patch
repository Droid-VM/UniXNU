+    let low = fb.glsl(GlslOp::FMin, &[low_xy, az])?;
+    let under = fb.glsl(GlslOp::FMin, &[high_xy, az])?;
+    let second = fb.glsl(GlslOp::FMax, &[low_xy, under])?;
