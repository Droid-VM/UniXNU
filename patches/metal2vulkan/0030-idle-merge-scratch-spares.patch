+/// Drop every shadow's spare scratches kept unused for `idle` or longer (all of them for
+/// `Duration::ZERO`, the system's memory pressure), with the device's idle trim
+/// (`Device::trim_kept_memory`): how many went. A shadow merged no more kept its two for as long
+/// as it lived (DroidVM: a still wallpaper's drawables held 64 MiB of them, wired guest memory).
+/// A later merge makes its scratch again.
+pub(crate) fn trim_scratch_spares(idle: Duration) -> usize {
+    let now = Instant::now();
+    let mut gone: Vec<Buffer> = Vec::new();
+    lock(&ALL_SPARES).retain(|weak| {
+        let Some(spares) = weak.upgrade() else {
+            return false;
+        };
+        let mut spares = lock(&spares);
+        let mut at = 0;
+        while at < spares.len() {
+            match now.saturating_duration_since(spares[at].1) >= idle {
+                true => gone.push(spares.swap_remove(at).0),
+                false => at += 1,
+            }
+        }
+        true
+    });
+    // The buffers go with no lock held.
+    let count = gone.len();
+    drop(gone);
+    count
