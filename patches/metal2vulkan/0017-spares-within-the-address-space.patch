+    /// Free the oldest spare blocks until the rest hold no more than the bound
+    /// ([`Memory::bound_spares`]).
+    fn trim_spare(&mut self, device: &ash::Device) {
+        let mut held: u64 = self.spare.iter().map(|spare| spare.block.size).sum();
+        while held > self.spare_limit {
+            let oldest = (self.spare.iter().enumerate()).min_by_key(|(_, spare)| spare.since);
+            let Some((oldest, _)) = oldest else {
+                break;
+            };
+            let spare = self.spare.swap_remove(oldest);
+            held -= spare.block.size;
+            // SAFETY: nothing is placed in a spare block, and no command reads it.
+            drop(unsafe { self.let_go(device, spare.block, FreeCause::KeptStale, None) });
+        }
+    }
