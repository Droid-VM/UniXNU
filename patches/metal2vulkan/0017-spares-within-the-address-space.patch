+    /// Hold the spare blocks to a sixteenth of the device's GPU address space,
+    /// `address_space` bytes (`sparseAddressSpaceSize`; 0: no bound). Every block of the device
+    /// takes addresses from that space, the driver's own too: where it is small (a virtio GPU
+    /// context's 2 GiB slice of the host GPU's), spares left no room for the driver's next
+    /// allocation, which no spare can be given back for, and the render server lost its device
+    /// (Turnip's autotune BO, `VK_ERROR_OUT_OF_DEVICE_MEMORY` with no allocation refused).
+    pub(super) fn bound_spares(&mut self, address_space: u64) {
+        self.spare_limit = match address_space {
+            0 => u64::MAX,
+            bytes => bytes / 16,
+        };
+    }
