+/// The colors the specialized fragment entry `spec` reads through a `[[color(n)]]` input of a
+/// constant index that a render pipeline whose color attachments are `colors` has no attachment
+/// for (`LoweringInputs::unattached_reads`).
+pub(crate) fn unattached_colors_read(
+    spec: &air::Entry,
+    colors: &[Option<ColorAttachmentDescriptor>],
+) -> BTreeSet<u32> {
+    if !matches!(spec.ep.stage, AbiStage::Fragment { .. }) {
+        return BTreeSet::new();
+    }
+    spec.ep
+        .params
+        .iter()
+        .filter_map(|b| match b.role {
+            ParamRole::ColorInput {
+                index: AbiInt::Const(a),
+                ..
+            } => Some(a),
+            _ => None,
+        })
+        .filter(|&a| colors.get(a as usize).copied().flatten().is_none())
+        .collect()
+}
