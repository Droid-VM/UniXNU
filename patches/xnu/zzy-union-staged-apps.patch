diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 792427d..340eff3 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7818,6 +7818,43 @@ native_staged_apps_prepare(proc_t p, user_addr_t scratch, mount_t data_mount)
 	vnode_put(vp);
 }
 
+/* The deletable system apps (Weather, Calendar, Notes, Maps, ...) ship in the OS volume's /private/var/staged_system_apps: a restore copies
+ * that directory into the Data volume, and the first boot's data migration (SystemAppMigrator) installs the apps from there. An owner
+ * Data seed carries no copy and marks the migration done, so with boot-arg owner-staged-apps=1 the sealed directory itself is shown as a
+ * read-only union view over /Applications, mounted while /private/var still resolves to the OS volume (the Data mount covers it next).
+ * The apps then register as built-in system apps; their code is in the static trust cache with the rest of the OS. Never panics: a
+ * refused mount only records its status. */
+volatile int native_staged_view_stage = 0;
+volatile int native_staged_view_status = -1;
+static void
+native_staged_view_prepare(proc_t p, user_addr_t scratch)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("owner-staged-apps", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	static const char source[] = "/private/var/staged_system_apps", point[] = "/Applications";
+	native_gpu_addon_mount(p, scratch, 0x800, source, sizeof(source), point, sizeof(point), "/Applications/Preferences.app/Info.plist",
+	    "/Applications/Weather.app/Info.plist", &native_staged_view_stage, &native_staged_view_status);
+}
+
+/* With boot-arg owner-tools-overlay=1 the owner's tools in the Data volume's /private/var/ngpu/bin also show, read-only, over
+ * /usr/libexec. launchd starts only the jobs of the system's cached job set, by their program paths, so an owner tool runs by
+ * taking the file name of a job the board has no use for (the board names which). Mounted after the Data mount; never panics. */
+volatile int native_owner_tools_stage = 0;
+volatile int native_owner_tools_status = -1;
+static void
+native_owner_tools_prepare(proc_t p, user_addr_t scratch)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("owner-tools-overlay", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	static const char source[] = "/private/var/ngpu/bin", point[] = "/usr/libexec";
+	native_gpu_addon_mount(p, scratch, 0xa00, source, sizeof(source), point, sizeof(point), "/usr/libexec/lockdownd",
+	    "/usr/libexec/IOMFB_bics_daemon", &native_owner_tools_stage, &native_owner_tools_status);
+}
+
 static int
 native_owner_data_prepare(proc_t p, user_addr_t scratch)
 {
@@ -7861,6 +7898,8 @@ native_owner_data_prepare(proc_t p, user_addr_t scratch)
 	    (error = copyout("/private/var", request.path, 13)) ||
 	    (error = copyout(device_path, spec, strlen(device_path) + 1)) ||
 	    (error = copyout(payload, request.data, sizeof(payload)))) goto done;
+	/* still the OS volume's /private/var */
+	native_staged_view_prepare(p, scratch);
 	native_owner_data_stage = 2;
 	error = mount(p, &request, &result);
 	if (error) goto done;
@@ -7878,6 +7917,7 @@ native_owner_data_prepare(proc_t p, user_addr_t scratch)
 	if (!error) native_owner_data_stage = 4;
 	if (!error) native_gpu_addon_prepare(p, scratch);
 	if (!error) native_staged_apps_prepare(p, scratch, data_mount);
+	if (!error) native_owner_tools_prepare(p, scratch);
 done:
 	if (data_root) vnode_put(data_root);
 	native_owner_data_status = error;
@@ -8556,8 +8596,20 @@ process_signature(proc_t p, struct image_params *imgp)
 	/* call the launch constraints hook */
 	os_reason_t launch_constraint_reason;
 	if ((error = mac_proc_check_launch_constraints(p, imgp, &launch_constraint_reason)) != 0) {
-		signature_failure_reason = launch_constraint_reason;
-		goto done;
+		/* AMFI (the original RELEASE kext) gates a system-service launch on a platform binary, which an owner-signed tool
+		 * in the owner trust module is not, so it is killed with a Launch Constraint Violation. This VM is not a security
+		 * boundary; owner-skip-launch-constraints=1 lets such a tool take a daemon's place. */
+		uint32_t owner_skip_launch_constraints = 0;
+		if (PE_parse_boot_argn("owner-skip-launch-constraints", &owner_skip_launch_constraints,
+		    sizeof(owner_skip_launch_constraints)) && owner_skip_launch_constraints == 1) {
+			if (launch_constraint_reason != OS_REASON_NULL) {
+				os_reason_free(launch_constraint_reason);
+			}
+			error = 0;
+		} else {
+			signature_failure_reason = launch_constraint_reason;
+			goto done;
+		}
 	}
 
 #if XNU_TARGET_OS_OSX
