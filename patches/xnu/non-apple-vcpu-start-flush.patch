+#if !defined(APPLE_ARM64_ARCH_FAMILY)
+/*
+ * A core's early bootstrap, traced in its 64-byte slot of droidvm_early_trace (osfmk/arm64/cpu.c; slot = MPIDR Aff0): where it
+ * got to, and the exception that stopped it. The stores are uncached while the MMU is off; cpu_start() wrote the array back
+ * from the caches first, so the guest and its host read what the core wrote. Clobbers x9 and x10.
+ */
+.macro EARLY_TRACE_SLOT
+	mrs		x9, MPIDR_EL1
+	and		x9, x9, #7
+	adrp	x10, EXT(droidvm_early_trace)@page
+	add		x10, x10, EXT(droidvm_early_trace)@pageoff
+	add		x9, x10, x9, lsl #6
+.endmacro
+
+.macro EARLY_TRACE_STAGE stage
+	EARLY_TRACE_SLOT
+	mov		x10, #\stage
+	str		x10, [x9]
+	dsb		sy
+.endmacro
+
+/*
+ * An exception in early bootstrap: record it (with the MMU off only; with it on, the slot's physical address may not be mapped)
+ * and park in WFI rather than spin. Gunyah traps WFI and blocks the vCPU, but a vCPU spinning here kept its physical core until
+ * the host's watchdog rebooted the phone.
+ */
+.macro EARLY_TRAP vector
+	msr		DAIFSet, #(DAIFSC_ALL)
+	mrs		x9, SCTLR_EL1
+	tbnz	x9, #0, 1f
+	EARLY_TRACE_SLOT
+	mov		x10, #(0xe0 + \vector)
+	str		x10, [x9]
+	mrs		x10, ELR_EL1
+	str		x10, [x9, #8]
+	mrs		x10, ESR_EL1
+	str		x10, [x9, #16]
+	mrs		x10, FAR_EL1
+	str		x10, [x9, #24]
+	mrs		x10, SPSR_EL1
+	str		x10, [x9, #32]
+	dsb		sy
+1:
+	wfi
+	b		1b
+.endmacro
+#endif
